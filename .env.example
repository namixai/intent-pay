# Copy to .env and fill in. .env is ignored by git; never commit real values.
# Demo mode needs none of these: it replays a recorded scenario with no network calls.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# The card the gateway pays with. Either a saved card's vault ID:
PAYPAL_CARD_VAULT_ID=
# or a sandbox test card (developer.paypal.com, sandbox card generator). Expiry is YYYY-MM.
PAYPAL_CARD_NUMBER=
PAYPAL_CARD_EXPIRY=
PAYPAL_CARD_SECURITY_CODE=
# Optional. In the sandbox a rejection trigger such as CCREJECT-REFUSED here makes the card decline.
PAYPAL_CARD_NAME=

# Airwallex sandbox (sandbox.airwallex.com > Account > Developer > API keys).
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_API_BASE=https://api.sandbox.airwallex.com

# Live agent mode only: INTENT_PAY_AGENT=claude lets Claude propose the payments instead of the
# scenario script. Needs pip install -e ".[agent]" and your own key; the calls are billed to it.
# INTENT_PAY_MODEL defaults to claude-sonnet-5-5.
INTENT_PAY_AGENT=
ANTHROPIC_API_KEY=
INTENT_PAY_MODEL=

# Where the decision ledger is written. Defaults to ./state/ledger.jsonl.
INTENT_PAY_LEDGER=
