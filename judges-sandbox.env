# PayPal sandbox keys for hackathon judges. They work in the PayPal sandbox only.
# Run: python -m intent_pay.web --sandbox --env judges-sandbox.env
# While the values below are empty, the page opens and each step answers "missing environment variable(s)".
# The default demo needs none of this: python -m intent_pay.web

# The sandbox app made for judges (developer.paypal.com > Apps & Credentials > Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# The card the gateway pays with: a sandbox test card from PayPal. Expiry is YYYY-MM.
PAYPAL_CARD_NUMBER=
PAYPAL_CARD_EXPIRY=

# The code does not read these two. The e-mail names the sandbox business account the payments go to.
# Its password stays empty and is not shared: the page and the ledger show every payment.
PAYPAL_SANDBOX_BUSINESS_EMAIL=
PAYPAL_SANDBOX_BUSINESS_PASSWORD=
